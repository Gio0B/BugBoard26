# Application
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=8080
API_BASE_URL=http://localhost:3000/api

# PostgreSQL over TLS - replace locally; never commit real values
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
TEST_JWT_SECRET=replace-with-a-separate-long-test-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:8080
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Idempotent demo seed
DEMO_ADMIN_EMAIL=admin@bugboard26.local
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
DEMO_USER_EMAIL=user@bugboard26.local
DEMO_USER_PASSWORD=replace-with-a-strong-demo-password

# Test database destructive-operation guard
ALLOW_TEST_DB_RESET=false

# Optional local SonarQube profile
SONAR_HOST_URL=http://sonarqube:9000

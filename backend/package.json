{
  "name": "bugboard26-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for BugBoard26",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/unit/coreHelpers.test.js",
    "test:unit": "node --test test/unit/coreHelpers.test.js",
    "test:coverage": "c8 --all --include=src/**/*.js --exclude=src/server.js --reporter=text --reporter=lcovonly --reports-dir=. node --test test/unit/coreHelpers.test.js",
    "quality:scan": "sonar-scanner-npm"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sonar/scan": "5.0.2",
    "c8": "12.0.0"
  },
  "overrides": {
    "node-forge": "1.4.3",
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
